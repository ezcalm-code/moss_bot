{
  "name": "moss-bots",
  "version": "0.1.3",
  "description": "Open-source chat bot for Telegram & Feishu, powered by any OpenAI-compatible LLM.",
  "keywords": [
    "telegram-bot",
    "feishu",
    "lark",
    "chatbot",
    "llm",
    "openai-compatible"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "main": "dist/index.js",
  "overrides": {
    "openai": {
      "zod": "^4.0.0"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "chat": "tsx src/cli/repl.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@larksuiteoapi/node-sdk": "^1.24.0",
    "grammy": "^1.21.0",
    "openai": "^5.0.0",
    "pino": "^9.0.0",
    "undici": "^7.30.2",
    "yaml": "^2.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "pino-pretty": "^12.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
