# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，不会入库。

# Telegram：找 @BotFather 发 /newbot 获取
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token

# 飞书：开发者后台自建应用 → 凭证与基础信息页获取
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me

# LLM provider 的 API key（名字对应 config.yaml 里的 apiKeyEnv）
XAI_API_KEY=replace_me
DEEPSEEK_API_KEY=replace_me
# Ollama 本地端点不校验 key，占位即可
LOCAL_API_KEY=not-needed-for-ollama

# Tavily 搜索（tools.webSearch.enabled=true 时必填）：https://tavily.com 免费注册，无需信用卡
TAVILY_API_KEY=replace_me

# 笔记加密密钥（AES-256-GCM 落盘加密；不设置则笔记功能禁用）。生成：openssl rand -hex 32
NOTES_ENCRYPTION_KEY=replace_me

# 智谱图像生成（imageGeneration.enabled=true 时必填）：bigmodel.cn 免费注册，CogView-3-Flash 免费档
ZHIPU_IMAGE_API_KEY=replace_me
